{
  "name": "wan2gp-desktop",
  "version": "2.6.1",
  "description": "Desktop launcher for Wan2GP — install, update, maintain and run Wan2GP with hardware-aware setup",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/settings-repair.test.js tests/auto-tune.test.js tests/signpath-sign.test.js tests/escape.test.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "publish:win": "electron-builder --win --publish always",
    "release:win": "bash scripts/release-win.sh"
  },
  "author": {
    "name": "GKartist75",
    "email": "GKartist75@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GKartist75/wan2gp-desktop"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
